        <mxCell id="kqnUi20qo3WXq_Gnl8jJ-60" edge="1" parent="1" source="kqnUi20qo3WXq_Gnl8jJ-37" style="endArrow=classic;html=1;rounded=1;sketch=0;fontSize=21;fontColor=#393C56;strokeColor=#E07A5F;fillColor=#F2CC8F;curved=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.001;entryY=0.807;entryDx=0;entryDy=0;entryPerimeter=0;" target="kqnUi20qo3WXq_Gnl8jJ-50" value="">
