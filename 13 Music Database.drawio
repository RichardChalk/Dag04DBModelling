        </mxCell>
        <mxCell id="kqnUi20qo3WXq_Gnl8jJ-61" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;sketch=0;fontSize=21;fontColor=#393C56;strokeWidth=2;" value="0,,M" vertex="1">
          <mxGeometry height="30" width="60" x="219" y="405" as="geometry" />
        </mxCell>
        <mxCell id="kqnUi20qo3WXq_Gnl8jJ-62" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;sketch=0;fontSize=21;fontColor=#393C56;strokeWidth=2;" value="1,,M" vertex="1">
          <mxGeometry height="30" width="60" x="206" y="350" as="geometry" />
        </mxCell>
        <mxCell id="kqnUi20qo3WXq_Gnl8jJ-63" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;sketch=0;fontSize=21;fontColor=#393C56;strokeWidth=2;" value="0,,M" vertex="1">
          <mxGeometry height="30" width="60" x="380" y="480" as="geometry" />
        </mxCell>
        <mxCell id="kqnUi20qo3WXq_Gnl8jJ-64" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;sketch=0;fontSize=21;fontColor=#393C56;strokeWidth=2;" value="1,,M" vertex="1">
          <mxGeometry height="30" width="60" x="420" y="530" as="geometry" />
        </mxCell>
        <mxCell id="5mEIO5cjB74_BYMxXYXw-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;h3&gt;Varför behöver vi kopplingstabeller (Bridge Tables)?&lt;/h3&gt;&lt;p&gt;I en relationsdatabas kan vi inte skapa en &lt;strong&gt;många-till-många-relation (M:M)&lt;/strong&gt; direkt mellan två tabeller. Vi behöver därför skapa en extra tabell som kallas &lt;strong&gt;kopplingstabell (Bridge Table)&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;Titta på vårt exempel:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;En &lt;strong&gt;Artist&lt;/strong&gt; kan ha flera &lt;strong&gt;Album&lt;/strong&gt;.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;Ett &lt;strong&gt;Album&lt;/strong&gt; kan ha flera &lt;strong&gt;Artister&lt;/strong&gt;.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Detta är en M:M-relation.&lt;/p&gt;&lt;p&gt;För att lösa detta behöver vi skapa en ny tabell som heter &lt;strong&gt;ArtistAlbum&lt;/strong&gt;.&lt;/p&gt;&lt;p&gt;Den innehåller två främmande nycklar (Foreign Keys):&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;p&gt;&lt;code dir=&quot;ltr&quot;&gt;Artist_id&lt;/code&gt; → refererar till &lt;code dir=&quot;ltr&quot;&gt;Artist&lt;/code&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;code dir=&quot;ltr&quot;&gt;Album_id&lt;/code&gt; → refererar till &lt;code dir=&quot;ltr&quot;&gt;Album&lt;/code&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Tillsammans kan dessa två kolumner bilda tabellens primärnyckel (Composite Primary Key).&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Resultatet:&lt;/strong&gt; Vi har nu ersatt en M:M-relation med två 1:M-relationer.&lt;/p&gt;&lt;p&gt;Samma princip gäller för &lt;strong&gt;Album&lt;/strong&gt; och &lt;strong&gt;Song&lt;/strong&gt; om en låt kan förekomma på flera album. Då skapar vi kopplingstabellen &lt;code dir=&quot;ltr&quot;&gt;AlbumSong&lt;/code&gt;.&lt;/p&gt;" vertex="1">
          <mxGeometry height="480" width="550" x="160" y="630" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
